{
  "name": "@luluthehungrycat/omp-pi-sandbox-oddsjam",
  "version": "0.1.1",
  "description": "OS-level sandbox for pi using @anthropic-ai/sandbox-runtime, with an in-pi configure wizard, shift+tab toggle, and longest-prefix project configs.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/luluthehungrycat/omp-pi-sandbox-oddsjam.git"
  },
  "homepage": "https://github.com/luluthehungrycat/omp-pi-sandbox-oddsjam#readme",
  "bugs": {
    "url": "https://github.com/luluthehungrycat/omp-pi-sandbox-oddsjam/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "sandbox",
    "security",
    "permissions",
    "bubblewrap",
    "seccomp",
    "sandbox-exec",
    "tui"
  ],
  "files": [
    "index.ts",
    "src/**/*.ts",
    "screenshots/**/*.png",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "./screenshots/sandbox-configure.png"
  },
  "omp": {
    "extensions": [
      "./index.ts"
    ]
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.51"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.0.0",
    "@oh-my-pi/pi-tui": ">=18.0.0",
    "@oh-my-pi/pi-utils": ">=18.0.0"
  },
  "devDependencies": {
    "@oh-my-pi/pi-agent-core": "18.0.0",
    "@oh-my-pi/pi-coding-agent": "18.0.0",
    "@oh-my-pi/pi-tui": "18.0.0",
    "@oh-my-pi/pi-utils": "18.0.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^24",
    "typescript": "^5.6.0"
  },
  "trustedDependencies": [
    "@anthropic-ai/sandbox-runtime"
  ]
}
